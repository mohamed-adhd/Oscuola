  <property name="styleSheet">
   <string notr="true">
/* ---------- Global look ---------- */
QMainWindow {
    background-color: #F4F6FB;
}

QLabel {
    color: #1F2937;
    font-family: &quot;Segoe UI&quot;;
}

/* ---------- Cards used on login / register ---------- */
QFrame#login_card, QFrame#reg_card, QFrame#recovery_card {
    background-color: #FFFFFF;
    border-radius: 18px;
    border: 1px solid #E5E9F2;
}

/* ---------- Titles ---------- */
QLabel#app_title, QLabel#app_title_reg {
    color: #4F46E5;
    font-family: &quot;Segoe UI&quot;;
    font-size: 30pt;
    font-weight: 800;
    font-style: italic;
}

QLabel#form_title, QLabel#form_title_reg {
    color: #111827;
    font-size: 17pt;
    font-weight: 700;
}

QLabel#form_subtitle, QLabel#form_subtitle_reg {
    color: #6B7280;
    font-size: 10pt;
}

/* ---------- Field labels ---------- */
QLabel#field_label_login_email, QLabel#field_label_login_password,
QLabel#field_label_reg_email, QLabel#field_label_reg_password, QLabel#field_label_reg_confirm,
QLabel#field_label_request_subject, QLabel#field_label_request_message {
    color: #374151;
    font-size: 10pt;
    font-weight: 600;
}

/* ---------- Inputs ---------- */
QLineEdit {
    background-color: #F9FAFB;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 11pt;
    color: #111827;
    selection-background-color: #4F46E5;
}
QLineEdit:focus {
    border: 1px solid #4F46E5;
    background-color: #FFFFFF;
}

/* ---------- Primary buttons ---------- */
QPushButton#login_but, QPushButton#btn_create_account, QPushButton#btn_send_request, QPushButton#recovery_send_btn {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 11pt;
    font-weight: 700;
}
QPushButton#login_but:hover, QPushButton#btn_create_account:hover, QPushButton#btn_send_request:hover, QPushButton#recovery_send_btn:hover {
    background-color: #4338CA;
}
QPushButton#login_but:pressed, QPushButton#btn_create_account:pressed, QPushButton#btn_send_request:pressed, QPushButton#recovery_send_btn:pressed {
    background-color: #3730A3;
}

/* ---------- Secondary / link-style buttons ---------- */
QPushButton#reg_but {
    background-color: transparent;
    color: #4F46E5;
    border: none;
    font-size: 11pt;
    font-weight: 700;
    text-decoration: underline;
}
QPushButton#reg_but:hover {
    color: #4338CA;
}

/* ---------- Alerts (auth forms) ---------- */
QLabel#login_alert, QLabel#reg_alert {
    color: #DC2626;
    font-size: 10pt;
    font-weight: 600;
}

/* ---------- Sidebar (main menu) ---------- */
QFrame#sidebar, QFrame#sidebar_2, QFrame#sidebar_3, QFrame#sidebar_4, QFrame#sidebar_5 {
    background-color: #111827;
}
QLabel#sidebar_title, QLabel#sidebar_title_3, QLabel#sidebar_title_4, QLabel#sidebar_title_5, QLabel#sidebar_title_6 {
    color: #FFFFFF;
    font-size: 18pt;
    font-weight: 800;
    font-style: italic;
}
QPushButton#grades_button_student_1, QPushButton#alerts_student_but_1, QPushButton#post_button_student_1, QPushButton#timetable_but_student_1,
QPushButton#pushButton_9, QPushButton#alerts_student_but_4, QPushButton#post_button_student_2, QPushButton#timetable_but_student_3,
