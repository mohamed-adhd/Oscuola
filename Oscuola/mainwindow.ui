}

/* ---------- Logout button (bottom of sidebar) ---------- */
QPushButton#logout_but_1, QPushButton#logout_but_2, QPushButton#logout_but_3, QPushButton#logout_but_4, QPushButton#logout_but_5 {
    background-color: transparent;
