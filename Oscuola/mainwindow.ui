}

/* ---------- Dashboard detail panels ---------- */
QFrame#panel_alerts_recent, QFrame#panel_absence_log, QFrame#panel_grades,
QFrame#panel_alerts_all, QFrame#panel_post_request, QFrame#panel_timetable, QFrame#panel_timetable_picture {
