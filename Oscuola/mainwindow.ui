    border: none;
    gridline-color: #F3F4F6;
    font-size: 10pt;
    color: #374151;
}
QTableWidget#grades_table::item, QTableWidget#timetable_table::item {
    padding: 8px;
}
QHeaderView::section {
    background-color: #F9FAFB;
    color: #374151;
    font-weight: 700;
    border: none;
    border-bottom: 1px solid #E5E9F2;
    padding: 8px;
}

/* ---------- Timetable picture placeholder ---------- */
