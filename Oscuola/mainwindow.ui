QLabel#user_name_label {
    color: #111827;
    font-size: 12pt;
    font-weight: 700;
}

QLabel#label_5, QLabel#label_13, QLabel#label_15, QLabel#label_17, QLabel#label_19 {
    color: #111827;
    font-size: 22pt;
    font-weight: 800;
}
QLabel#label_10, QLabel#label_14, QLabel#label_16, QLabel#label_18, QLabel#label_20 {
    color: #6B7280;
    font-size: 11pt;
}

/* ---------- Dashboard summary cards ---------- */
QFrame#dash_card_score, QFrame#dash_card_absences, QFrame#dash_card_alerts {
    background-color: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #E5E9F2;
}
QLabel#dash_value_score {
    font-size: 28pt;
    font-weight: 800;
