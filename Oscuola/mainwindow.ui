    border-bottom: 1px solid #F3F4F6;
}

/* ---------- Back to Home button ---------- */
QPushButton#back_home_btn, QPushButton#back_home_btn_2, QPushButton#back_home_btn_3, QPushButton#back_home_btn_4, QPushButton#recovery_back_btn {
