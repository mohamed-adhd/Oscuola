QPushButton#pushButton_9:pressed, QPushButton#alerts_student_but_4:pressed, QPushButton#post_button_student_2:pressed, QPushButton#timetable_but_student_3:pressed,
QPushButton#grades_button_student_4:pressed, QPushButton#pushButton_14:pressed, QPushButton#post_button_student_3:pressed, QPushButton#timetable_but_student_2:pressed,
QPushButton#grades_button_student_2:pressed, QPushButton#alerts_student_but_2:pressed, QPushButton#pushButton_19:pressed, QPushButton#timetable_but_student_4:pressed,
